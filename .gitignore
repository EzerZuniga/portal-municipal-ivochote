# Dependencies
/vendor/
/node_modules/

# Local tooling caches
/.composer/

# Environment and secrets
/.env
/.env.*
!/.env.example
/auth.json

# Build outputs
/dist/
/build/
/public/hot
/public/storage

# Laravel runtime artifacts
/bootstrap/cache/*.php
/storage/*.key
/storage/pail
/storage/logs/*.log
/storage/framework/cache/*
!/storage/framework/cache/.gitkeep
/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep
/storage/framework/testing/*
!/storage/framework/testing/.gitkeep
/storage/framework/views/*
!/storage/framework/views/.gitkeep
/database/*.sqlite

# Test and analysis artifacts
/.phpunit.result.cache
/coverage/
.php-cs-fixer.cache

# Logs and temp files
*.log
*.cache
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE and editors
/.idea/
/.vscode/
*.swp
*.swo

# Operating system files
.DS_Store
Thumbs.db
